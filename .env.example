# Copy to .env. Never commit real credentials. Server only.
OPENAI_API_KEY=
# Choose a Responses API model with Structured Outputs available to your account.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
PORT=4173
# Optional bearer token for server-to-server API clients. Keep this server-side.
# The browser UI does not send this token; enabling it blocks its AI requests.
MARKET_MAKER_API_TOKEN=
