# Copy to .env at repository root. Leave credentials empty until configured.
OPENAI_API_KEY=
# Choose a model your project can use with Responses + strict Structured Outputs.
# No model alias is silently selected; both key and model are required to enable AI.
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT_TOKENS=4096
# Optional billing-rate inputs for an estimate (not the provider invoice).
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
AI_DAILY_CALL_LIMIT=20

HOST=127.0.0.1
PORT=4173
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
RUN_STORE=local
RUN_STORE_PATH=.local/workspace-runs.json

# Optional cloud database only. There is no user authentication in this MVP.
# The service-role credential belongs on the backend only; never use VITE_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Empty = same-origin API (Vite development proxies /api to port 4173).
VITE_API_BASE_URL=
