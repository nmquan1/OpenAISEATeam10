{
  "name": "market-maker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend",
    "frontend",
    "contracts"
  ],
  "scripts": {
    "start": "npm run start --workspace @market-maker/backend",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @market-maker/frontend",
    "test": "tsx --test backend/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "eval:ai": "tsx scripts/eval-ai.ts",
    "eval:evidence": "tsx scripts/eval-evidence.ts",
    "eval:technical": "tsx scripts/eval-technical.ts",
    "eval:retrieval": "tsx scripts/evaluation/retrieval-audit.ts",
    "research": "tsx scripts/research/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/static": "^10.1.8",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
